# ═══════════════════════════════════════════════════════════════════════════════
# PasarGuard Autoscaler Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── Timing ────────────────────────────────────────────────────────────────────
# How often (seconds) to run a full check cycle
INTERVAL=300

# Max seconds to wait for check-host.net ping results
PING_POLL_TIMEOUT=120

# Max seconds to wait for a Doprax VM to become active after creation
VM_READY_TIMEOUT=300

# Seconds between VM status polls
VM_READY_POLL_INTERVAL=10

# ── Thresholds ────────────────────────────────────────────────────────────────
# Minimum acceptable ping success rate (percent)
# Nodes below this AND above MINIMUM_PING will be replaced
MINIMUM_RATING=80

# Maximum acceptable average ping time (milliseconds)
MINIMUM_PING=200

# ── Doprax ─────────────────────────────────────────────────────────────────────
# Your Doprax API key (format: '<prefix>.<secret>')
DOPRAX_API_KEY=

# OS image to use for new VMs (must match Doprax catalogue image codes)
DOPRAX_IMAGE=ubuntu-22.04

# Maximum monthly budget per VM (USD)
MAX_BUDGET=5

# Comma-separated list of valid country codes for new VMs
VALID_COUNTRIES=ir

# Comma-separated list of valid datacenter codes (leave empty for any in VALID_COUNTRIES)
# Example: ir-thr,ir-mhd
VALID_DATACENTERS=

# ── Scaling ───────────────────────────────────────────────────────────────────
# Minimum number of active nodes to maintain
# If active nodes drop below this, new nodes are provisioned automatically
MIN_NODES=1

# Max number of attempts when creating/replacing a VM
# If a VM fails validation (not ready / bad ping), it is deleted and a new
# attempt is made with a different datacenter, up to this many tries.
MAX_CREATE_RETRIES=3

# Inbound tag for auto-created hosts (leave empty to skip host creation)
PASARGUARD_HOST_INBOUND_TAG=your-inbound-tag-here

# ── PasarGuard Panel ───────────────────────────────────────────────────────────
PASARGUARD_BASE_URL=
PASARGUARD_ADMIN_USERNAME=
PASARGUARD_ADMIN_PASSWORD=

# ── PasarGuard Node Defaults (used when adding new nodes to panel) ─────────────
# Connection type for new nodes: rest or grpc
PASARGUARD_NODE_CONNECTION_TYPE=rest

# Keep-alive interval (seconds)
PASARGUARD_NODE_KEEP_ALIVE=30

# Core config ID from your PasarGuard panel
PASARGUARD_NODE_CORE_CONFIG_ID=1

# Usage coefficient (multiplier for traffic accounting)
PASARGUARD_NODE_USAGE_COEFFICIENT=1

# Data limit in bytes (0 = unlimited)
PASARGUARD_NODE_DATA_LIMIT=0

# Default timeout (seconds)
PASARGUARD_NODE_DEFAULT_TIMEOUT=10

# Internal timeout (seconds)
PASARGUARD_NODE_INTERNAL_TIMEOUT=15

# ── State File ─────────────────────────────────────────────────────────────────
# Path to the autoscaler state file (tracks replacements, failed DCs, etc.)
# Leave empty for default (same directory as this script)
STATE_FILE=
